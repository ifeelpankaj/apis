NODE_ENV=development
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# PostgreSQL connection (local instance — set to your credentials)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=cab_management_db

# Pool tuning (production: increase DB_POOL_MAX to 20, DB_POOL_MIN to 5)
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
DB_MAX_LIFETIME_SECONDS=1800
DB_KEEP_ALIVE=true
DB_KEEP_ALIVE_INITIAL_DELAY_MS=10000
DB_ALLOW_EXIT_ON_IDLE=false

# Operational tuning
DB_STARTUP_RETRIES=3
DB_STARTUP_RETRY_DELAY_MS=2000
DB_DRAIN_TIMEOUT_MS=10000
DB_TX_MAX_RETRIES=3
DB_POOL_SATURATION_THRESHOLD=0.9
DB_SLOW_QUERY_MS=200

# SSL (production: DB_SSL_MODE=verify-full + DB_SSL_CA or DB_SSL_CA_PATH)
DB_SSL_MODE=disable

# JWT / Auth
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ISSUER=cab-management-api
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800
OTP_SECRET=dev-otp-secret-change-in-production
OTP_EXPIRY_SECONDS=600

# SMTP (optional in development — OTP returned as dev_otp when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cab-management.local

# Driver onboarding
DRIVER_VEHICLE_REQUIRED=false

# ImageKit (client uploads use GET /api/v1/media/upload-auth)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/demo

# Ride booking / maps / payments
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
FARE_ROUND_TRIP_MULTIPLIER=2
PARTIAL_ADVANCE_PERCENT=30

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SERVICE_NAME=cab-management-api
LOG_DIR=logs
