{
  "transforms": [
    {
      "mode": "sql",
      "include": "**/*.sql",
      "emitTemplate": "{{dir}}/{{name}}.queries.ts"
    }
  ],
  "srcDir": "./db/queries/",
  "failOnError": true,
  "camelCaseColumnNames": false,
  "db": {
    "host": "localhost",
    "port": 5432,
    "ssl": false
  }
}
